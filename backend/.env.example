# ============================================================
# Flowmint AI — Backend Environment Configuration (.env.example)
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_NAME=flowmint-ai
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://flowmint:flowmint_dev@localhost:5432/flowmint_db
DATABASE_URL_SYNC=postgresql://flowmint:flowmint_dev@localhost:5432/flowmint_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Razorpay (TEST MODE ONLY) ---
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Configuration (Phase 2A) ---
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1024
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p8-max
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

