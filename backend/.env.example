# ============================================================
# Flowmint AI — Backend Environment Configuration (.env.example)
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_NAME=flowmint-ai
APP_ENV=development
DEBUG=true
SECRET_KEY=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=

DATABASE_URL_SYNC=

# --- Redis ---
REDIS_URL=

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend & Backend URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Store Integration Credentials & Encryption ---
STORE_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/stores/shopify/callback
SHOPIFY_API_VERSION=2024-01

# --- Razorpay ---
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Configuration (Phase 2A) ---
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1024
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p8-max
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

