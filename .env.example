# ============================================================
# Flowmint AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_NAME=flowmint-ai
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://flowmint:flowmint_dev@localhost:5432/flowmint_db
DATABASE_URL_SYNC=postgresql://flowmint:flowmint_dev@localhost:5432/flowmint_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Razorpay (TEST MODE ONLY) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
